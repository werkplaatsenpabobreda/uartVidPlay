<?xml version="1.0" encoding="utf-8"?>
<project>
	
	<meta title="UartVidPlay" package="nl.avans.uartvidplay" version="1.0.1" company="Avans" build-number=".build" />

	<section unless="useSerial">
		<app main="Main" path="Release" file="UartVidPlay" unless="debug"/>
		<app main="Main" path="Debug" file="UartVidPlay_Debug" if="debug" />
	</section>

	<section if="useSerial">
		<app main="Main" path="Release_Serial" file="UartVidPlay" unless="debug"/>
		<app main="Main" path="Debug_Serial" file="UartVidPlay_Debug" if="debug" />
	</section>

	<source path="Source" />
	
	<haxelib name="openfl" />
	<haxelib name="hxvlc"/>
	<haxelib name="signals"/>
	<haxelib name="hxserial"/>
	<haxelib name="hxwebsockets"/>
	

	<section if="mac">
		<haxedef name="MACOSX_VER" value="26.2"/>
	</section>

 	<assets path="dependencies/Windows64" rename="" include="*.ndll" if="windows"/>
	<assets path="dependencies/Mac64" rename="" include="*.ndll" if="mac"/>
	
	<assets path="Assets/data" rename="data" />
	<assets path="Assets/images" rename="images" />

	<window background="#000000" fps="60" width="1024" height="576" resizeable="true"/>
</project>